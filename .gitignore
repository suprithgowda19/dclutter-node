# =======================================
# 🛡️ Full-Stack Monorepo Master .gitignore
# =======================================

# 1. Dependencies across all folders
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# 2. Environment Secrets (Never leak database passwords / keys)
.env
.env.local
.env.*.local
*.env
!.env.example

# 3. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Web Build Outputs (React, Vite, Next.js)
dist/
dist-ssr/
build/
out/
.next/
*.local

# 5. Mobile (Expo & React Native)
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# 6. Android & iOS Native Builds
android/app/build/
android/.gradle/
ios/Pods/
ios/build/

# 7. OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# 8. Database & SQLite
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# 9. Docker & Testing
coverage/
.nyc_output/
